# Public site origin used for metadata. No path, no trailing slash.
# Example: https://omega.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth for signup and login. Do not commit real keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY accepts the anon key or the publishable key.
# A service role key is a server secret and must never use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
